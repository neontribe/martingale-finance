# Copy this file to .env and fill in your own values.
# Never commit a populated .env — it contains credentials.
#
# Every variable below is read by app/config.py at import time. The ones marked
# REQUIRED will cause the application to fail on start-up if they are absent.

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------

# "development" or "testing" route all Beacon HTTP calls through the mock layer
# (app/libs/http_strategy_selector.py) so no network requests are sent to Beacon CRM.
# Any other value (e.g. "production") makes real HTTP requests.
#
# Optional. Default: development
ENV=development

# Five-field standard cron expression (minute hour day month day-of-week).
# Controls how often the scheduled runner fires when started via start_scheduler().
# Not used when running the one-shot task (do_task_now()).
#
# Optional. Default: */1 * * * * (every minute, for local testing)
SCHEDULE_CRON="*/1 * * * *"

# ---------------------------------------------------------------------------
# Beacon CRM
# ---------------------------------------------------------------------------

# Bearer token for accessing the Beacon CRM developer API.
#
# REQUIRED.
API_BEARER_TOKEN=your_beacon_bearer_token_here

# The Beacon CRM REST endpoint to query for application records.
#
# REQUIRED.
API_URL=https://api.beaconcrm.org/v1/account/12345/entity/c_application

# ---------------------------------------------------------------------------
# Google Cloud / Vertex AI
# ---------------------------------------------------------------------------

# The Google Cloud Project ID where Vertex AI and Cloud Storage reside.
#
# REQUIRED.
PROJECT_ID=your_gcp_project_id_here

# The Google Cloud Storage bucket used as a transient staging area for documents
# during Vertex AI analysis. Should reside in the same region as Vertex AI (europe-west2).
#
# REQUIRED.
GCS_BUCKET_NAME=your_gcs_bucket_name_here

# Service account credentials for Google Cloud Storage and Vertex AI.
# Accepts either:
#   1. A file path relative to project root (e.g. ".vertexai.json")
#   2. A raw JSON string containing the complete service account credentials
#
# REQUIRED. Default: .vertexai.json
GOOGLE_APPLICATION_CREDENTIALS_JSON=.vertexai.json
